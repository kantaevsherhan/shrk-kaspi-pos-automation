TOKEN_SECRET_KEY=
SERVICE_API_KEYS={"pos-service":"replace-with-a-random-secret-of-at-least-32-characters"}
# WEBHOOKS_FILE=./data/webhooks.json
PORT=3000
HOST=127.0.0.1
# STATE_DIR=./data
# FRONTEND_DIR=./web/dist

# ─── App version & device constants (optional) ───
# Defaults are a client profile and may need updating as Kaspi changes its API.
# ⚠️ The Kaspi API validates these — use values from a real device cookie.
# Kaspi raises its minimum app version periodically; when it does, login fails at the phone step with
# "OldVersionToUpdate" for every cashier. Set these to the current Kaspi Pay iOS release + build and restart.
# APP_VERSION=26.0921
# APP_BUILD=1115
# APP_PLATFORM=iOS
# APP_PLATFORM_VER=18.4
# APP_LOCALE=ru-RU
# APP_MODEL=iPhone16,2
# APP_BRAND=Apple
# APP_DEVICE_NAME=iPhone
# APP_SCREEN_W=430.0
# APP_SCREEN_H=932.0
# APP_CFNETWORK=CFNetwork/3826.400.120
# APP_DARWIN=Darwin/24.4.0
